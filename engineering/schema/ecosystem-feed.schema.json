{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Syzygy-Hub/.github/blob/main/engineering/schema/ecosystem-feed.schema.json",
  "title": "Syzygy ecosystem feed (ecosystem/feed.json)",
  "description": "Generated by engineering/tooling/ecosystem-feed/generate_feed.py from the syzygy.yml manifests of the 24 platform repositories plus the Hub entry. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_from", "layers"],
  "properties": {
    "schema": { "const": "syzygy-ecosystem-feed/1" },
    "generated_from": { "const": "syzygy.yml files" },
    "layers": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "semver": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Bare strict semver with no v prefix, or null when the manifest has no version."
    },
    "constraint": {
      "type": ["string", "null"],
      "pattern": "^(>=|<=|>|<|~|\\^)?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "platforms"],
      "properties": {
        "layer": { "enum": ["foundation", "ui", "core", "services", "ai", "base", "hub"] },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/platform" }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "repos"],
      "properties": {
        "platform": { "enum": ["ios", "android", "rn", "flutter", "none"] },
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repo" }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "type", "version", "status", "language", "package_manager",
        "syzygy_foundation", "dependency_constraints", "license", "repo_url",
        "ci_workflow", "release_workflow"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(hub|syzygy-(foundation|ui|core|services|ai|base)-(ios|android|rn|flutter))$"
        },
        "type": { "enum": ["foundation", "ui", "core", "services", "ai", "base", "hub"] },
        "version": { "$ref": "#/$defs/semver" },
        "status": {
          "enum": ["shipped", "unknown"],
          "description": "shipped when version is a bare semver; unknown when the manifest has no version (Hub)."
        },
        "language": { "enum": ["swift", "kotlin", "typescript", "dart", null] },
        "package_manager": { "enum": ["spm", "jitpack", "npm", "pub.dev", null] },
        "syzygy_foundation": { "$ref": "#/$defs/constraint" },
        "dependency_constraints": {
          "type": "object",
          "propertyNames": { "enum": ["ui", "core", "services", "ai", "base"] },
          "additionalProperties": { "$ref": "#/$defs/constraint" }
        },
        "license": { "enum": ["MIT", null] },
        "repo_url": {
          "type": "string",
          "pattern": "^https://github\\.com/Syzygy-Hub/[A-Za-z0-9._-]+$"
        },
        "ci_workflow": {
          "type": ["string", "null"],
          "description": "Not derivable from syzygy.yml. Always null in version 1 of the feed."
        },
        "release_workflow": {
          "type": ["string", "null"],
          "description": "Not derivable from syzygy.yml. Always null in version 1 of the feed."
        }
      }
    }
  }
}
