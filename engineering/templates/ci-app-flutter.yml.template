# Caller workflow: CI for a Flutter app. Copy to .github/workflows/ci.yml.
# Input names are the planned vocabulary; they are documented in .github/workflows/README.md
# of Syzygy-Hub/.github.
name: CI

on:
  push:
    branches: ['**']
  pull_request:
    branches: [main]

jobs:
  ci:
    uses: Syzygy-Hub/.github/.github/workflows/flutter-ci.yml@main
    with:
      working_directory: '.'
      runner: ubuntu-latest
      flutter_version: 'stable'
      build_smoke_android: true
      coverage: true
      upload_artifacts: true
      org_config_sha: 'main'
