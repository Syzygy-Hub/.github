# Caller workflow: release for an Android library (JitPack). Copy to .github/workflows/release.yml.
# Fires on strict bare-semver tags only (no v prefix). The Hub workflow validates the tag and
# syzygy.yml, extracts the CHANGELOG entry and creates the GitHub Release. JitPack builds from that
# tag. This caller runs no CI gate; see the commented block at the end to opt in.
name: Release

on:
  push:
    tags:
      - '[0-9]+.[0-9]+.[0-9]+'

permissions: {}

jobs:
  release:
    permissions:
      contents: write
    uses: Syzygy-Hub/.github/.github/workflows/android-release.yml@main
    # Passes the optional WEBSITE_DISPATCH_TOKEN (used only when notify_website_repo is set).
    secrets: inherit

# Optional CI gate (opt-in, commented out). Adopt by replacing the active `jobs:` block above with
# the block below. The gate calls ci-gate.yml, which checks that CI passed on the tagged commit
# (ci_gate defaults to enforce in ci-gate.yml). `release` then waits for `gate`.
