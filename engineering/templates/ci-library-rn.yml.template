# Caller workflow: CI for a React Native library (pure TypeScript). Copy to .github/workflows/ci.yml.
# Input names are the planned vocabulary; they are documented in .github/workflows/README.md
# of Syzygy-Hub/.github. Use .eslintrc.ts.json for TypeScript-only libraries.
name: CI

on:
  push:
    branches: ['**']
  pull_request:
    branches: [main]

jobs:
  ci:
    uses: Syzygy-Hub/.github/.github/workflows/rn-ci.yml@main
    with:
      working_directory: '.'
      runner: ubuntu-latest
      node_version: '22'
      eslint_config: '.eslintrc.ts.json'
      coverage: true
      upload_artifacts: true
      org_config_sha: 'main'
