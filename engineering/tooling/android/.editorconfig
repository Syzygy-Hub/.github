# Shared ktlint-compatible EditorConfig for all Syzygy Kotlin/Android repos
# (syzygy-base-android, syzygy-ui-android, and future Android libraries/apps).
#
# ktlint reads standard [*.{kt,kts}] EditorConfig properties plus the
# ktlint_* keys below directly — no separate ktlint config file is needed.
# See README.md for how consuming repos should fetch this file into CI.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
insert_final_newline = true

# Standard Kotlin conventions (match Android Kotlin style guide defaults).
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_import-ordering = enabled
ktlint_standard_max-line-length = enabled
ktlint_standard_final-newline = enabled
ktlint_standard_no-trailing-spaces = enabled

# Jetpack Compose: @Composable functions are named in PascalCase by convention,
# so the function-naming rule must skip them. Upstreamed from individual Android
# repos. Verified against the ktlint 1.x property name; confirm on the ktlint
# version used by the consuming build (ktlint Gradle plugin 12.1.2 in syzygy-ui-android).
# The property name was taken from secondary sources (web search), not from the ktlint
# release notes of the pinned version. Run ktlint against a PascalCase @Composable to confirm.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Trailing commas are optional stylistic preference in Kotlin; disabled so
# generated/multi-line call sites aren't forced one way or the other.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
