#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# Syzygy pre-push hook
# ─────────────────────────────────────────────────────────────────────
# Auto-detects the repo platform (iOS / Android / RN / Flutter),
# fetches the org-level lint config from Syzygy-Hub/.github, and runs
# the matching linter.  Blocks the push on lint failure.
#
# Install via:  engineering/hooks/setup-hooks.sh
# ─────────────────────────────────────────────────────────────────────

set -e

# ── Configuration ────────────────────────────────────────────────────
CONFIG_BASE_URL="https://raw.githubusercontent.com/Syzygy-Hub/.github/main/engineering/tooling"

# ── Helpers ──────────────────────────────────────────────────────────
red()   { printf '\033[1;31m%s\033[0m\n' "$1"; }
green() { printf '\033[1;32m%s\033[0m\n' "$1"; }
dim()   { printf '\033[2m%s\033[0m\n' "$1"; }

has_cmd() { command -v "$1" >/dev/null 2>&1; }

die() {
  red "✗ pre-push: $1"
  exit 1
}

warn_missing() {
  printf '\033[1;33m⚠ pre-push: %s is not installed — skipping lint.\033[0m\n' "$1"
  printf '  Install it and re-push to enforce lint locally.\n'
}

# Fetch a remote file into a local path; fail the push if curl fails.
fetch_config() {
  _url="$1"
  _dest="$2"
  if ! curl -fsSL "$_url" -o "$_dest" 2>/dev/null; then
    die "Could not fetch lint config from $_url"
  fi
}

# ── Platform detection ───────────────────────────────────────────────
# Priority order matters: Package.swift and pubspec.yaml are the most
# unambiguous.  build.gradle.kts can coexist with package.json in
# monorepos, but in the Syzygy layout each repo is single-platform,
# so checking in this order is sufficient.

detect_platform() {
  if [ -f "Package.swift" ]; then
    echo "ios"
  elif [ -f "pubspec.yaml" ]; then
    echo "flutter"
  elif [ -f "build.gradle.kts" ] || [ -f "build.gradle" ]; then
    echo "android"
  elif [ -f "package.json" ]; then
    echo "rn"
  else
    echo "unknown"
  fi
}

# ── Lint runners (one per platform) ─────────────────────────────────

lint_ios() {
  if ! has_cmd swiftlint; then
    warn_missing "swiftlint"
    return 0
  fi

  # Escape hatch: SYZYGY_LINT_LOCAL=1 uses local config if available
  if [ "$SYZYGY_LINT_LOCAL" = "1" ]; then
    dim "pre-push: SYZYGY_LINT_LOCAL=1 — using local config (offline mode)"
    dim "pre-push: running swiftlint…"
    swiftlint --quiet || return $?
    return 0
  fi

  dim "pre-push: fetching SwiftLint config…"
  fetch_config "${CONFIG_BASE_URL}/ios/.swiftlint.yml" ".swiftlint.yml.pre-push-tmp"

  dim "pre-push: running swiftlint…"
  if swiftlint --config ".swiftlint.yml.pre-push-tmp" --quiet; then
    rm -f ".swiftlint.yml.pre-push-tmp"
    return 0
  else
    _exit=$?
    rm -f ".swiftlint.yml.pre-push-tmp"
    return $_exit
  fi
}

lint_android() {
  # Android repos use the ktlint Gradle plugin, so the linter runs
  # through Gradle — no standalone binary needed.  The .editorconfig
  # is the config file ktlint reads.

  # Escape hatch: SYZYGY_SKIP_ANDROID_LINT=1 skips entirely (Gradle cold start)
  if [ "$SYZYGY_SKIP_ANDROID_LINT" = "1" ]; then
    dim "pre-push: SYZYGY_SKIP_ANDROID_LINT=1 — skipping Android lint (Gradle cold start)"
    return 0
  fi

  if [ ! -f "gradlew" ]; then
    warn_missing "gradlew (Gradle wrapper)"
    return 0
  fi

  # Escape hatch: SYZYGY_LINT_LOCAL=1 uses local config if available
  if [ "$SYZYGY_LINT_LOCAL" = "1" ]; then
    dim "pre-push: SYZYGY_LINT_LOCAL=1 — using local config (offline mode)"
    dim "pre-push: running ./gradlew ktlintCheck…"
    ./gradlew ktlintCheck --quiet || return $?
    return 0
  fi

  dim "pre-push: fetching ktlint .editorconfig…"
  fetch_config "${CONFIG_BASE_URL}/android/.editorconfig" ".editorconfig.pre-push-tmp"

  # Swap in the org config, run ktlint, then restore the original.
  _had_editorconfig=false
  if [ -f ".editorconfig" ]; then
    _had_editorconfig=true
    cp ".editorconfig" ".editorconfig.pre-push-bak"
  fi
  cp ".editorconfig.pre-push-tmp" ".editorconfig"
  rm -f ".editorconfig.pre-push-tmp"

  dim "pre-push: running ./gradlew ktlintCheck…"
  _rc=0
  ./gradlew ktlintCheck --quiet || _rc=$?

  # Restore original .editorconfig
  if [ "$_had_editorconfig" = true ]; then
    mv ".editorconfig.pre-push-bak" ".editorconfig"
  else
    rm -f ".editorconfig"
  fi

  return $_rc
}

lint_rn() {
  if ! has_cmd npx; then
    warn_missing "npx (Node.js)"
    return 0
  fi

  # Determine which ESLint config variant to fetch.
  # UI / Base / Services repos have JSX → use .eslintrc.json (React).
  # Foundation / Core repos are pure TS → use .eslintrc.ts.json.
  _eslint_file=".eslintrc.json"
  _repo_name=""
  if [ -f "syzygy.yml" ]; then
    _repo_name=$(grep '^name:' syzygy.yml 2>/dev/null | head -1 | sed 's/^name:[[:space:]]*//')
  fi

  case "$_repo_name" in
    *-foundation-*|*-core-*)
      _remote_file=".eslintrc.ts.json"
      ;;
    *)
      _remote_file=".eslintrc.json"
      ;;
  esac

  # Escape hatch: SYZYGY_LINT_LOCAL=1 uses local config if available
  if [ "$SYZYGY_LINT_LOCAL" = "1" ]; then
    dim "pre-push: SYZYGY_LINT_LOCAL=1 — using local config (offline mode)"
    dim "pre-push: running eslint…"
    # Use the repo's own npm run lint if available; fall back to npx eslint.
    if grep -q '"lint"' package.json 2>/dev/null; then
      npm run lint --silent || return $?
    else
      npx eslint src --ext .ts,.tsx --max-warnings=0 || return $?
    fi
    return 0
  fi

  dim "pre-push: fetching ESLint + Prettier configs…"
  fetch_config "${CONFIG_BASE_URL}/rn/${_remote_file}" ".eslintrc.json.pre-push-tmp"
  fetch_config "${CONFIG_BASE_URL}/rn/.prettierrc"     ".prettierrc.pre-push-tmp"

  # Swap in the org configs, run lint, then restore.
  for _f in .eslintrc.json .prettierrc; do
    if [ -f "$_f" ]; then
      cp "$_f" "${_f}.pre-push-bak"
    fi
    cp "${_f}.pre-push-tmp" "$_f"
    rm -f "${_f}.pre-push-tmp"
  done

  # Remove local .eslintrc.js/.cjs that would take precedence.
  _had_eslintrc_js=false
  _had_eslintrc_cjs=false
  if [ -f ".eslintrc.js" ];  then _had_eslintrc_js=true;  mv ".eslintrc.js"  ".eslintrc.js.pre-push-bak";  fi
  if [ -f ".eslintrc.cjs" ]; then _had_eslintrc_cjs=true; mv ".eslintrc.cjs" ".eslintrc.cjs.pre-push-bak"; fi

  dim "pre-push: running eslint…"
  _rc=0
  # Use the repo's own npm run lint if available (it knows the right
  # --ext and src/ paths); fall back to npx eslint for bare repos.
  if grep -q '"lint"' package.json 2>/dev/null; then
    npm run lint --silent || _rc=$?
  else
    npx eslint src --ext .ts,.tsx --max-warnings=0 || _rc=$?
  fi

  # Restore originals
  for _f in .eslintrc.json .prettierrc; do
    if [ -f "${_f}.pre-push-bak" ]; then
      mv "${_f}.pre-push-bak" "$_f"
    else
      rm -f "$_f"
    fi
  done
  if [ "$_had_eslintrc_js"  = true ]; then mv ".eslintrc.js.pre-push-bak"  ".eslintrc.js";  fi
  if [ "$_had_eslintrc_cjs" = true ]; then mv ".eslintrc.cjs.pre-push-bak" ".eslintrc.cjs"; fi

  return $_rc
}

lint_flutter() {
  if ! has_cmd flutter; then
    warn_missing "flutter"
    return 0
  fi

  # Escape hatch: SYZYGY_LINT_LOCAL=1 uses local config if available
  if [ "$SYZYGY_LINT_LOCAL" = "1" ]; then
    dim "pre-push: SYZYGY_LINT_LOCAL=1 — using local config (offline mode)"
    dim "pre-push: running flutter analyze…"
    flutter analyze --fatal-warnings || return $?
    return 0
  fi

  dim "pre-push: fetching Dart analysis config…"
  fetch_config "${CONFIG_BASE_URL}/flutter/analysis_options.yaml" "analysis_options.yaml.pre-push-tmp"

  # Swap in the org config, run analysis, then restore.
  _had_analysis=false
  if [ -f "analysis_options.yaml" ]; then
    _had_analysis=true
    cp "analysis_options.yaml" "analysis_options.yaml.pre-push-bak"
  fi
  cp "analysis_options.yaml.pre-push-tmp" "analysis_options.yaml"
  rm -f "analysis_options.yaml.pre-push-tmp"

  dim "pre-push: running flutter analyze…"
  _rc=0
  flutter analyze --fatal-warnings || _rc=$?

  # Restore
  if [ "$_had_analysis" = true ]; then
    mv "analysis_options.yaml.pre-push-bak" "analysis_options.yaml"
  else
    rm -f "analysis_options.yaml"
  fi

  return $_rc
}

# ── Main ─────────────────────────────────────────────────────────────

# Ensure we run from the repo root (git sets GIT_DIR but cwd might vary).
if [ -n "$GIT_DIR" ]; then
  cd "$(dirname "$GIT_DIR")"
fi

PLATFORM=$(detect_platform)

case "$PLATFORM" in
  ios)
    lint_ios
    ;;
  android)
    lint_android
    ;;
  rn)
    lint_rn
    ;;
  flutter)
    lint_flutter
    ;;
  unknown)
    dim "pre-push: could not detect platform — skipping lint."
    exit 0
    ;;
esac

# If we reach here, lint passed.
green "✓ pre-push lint passed (${PLATFORM})"
